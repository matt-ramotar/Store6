CREATE TABLE user (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL
);

selectById:
SELECT *
FROM user
WHERE id = ?;

upsert:
INSERT INTO user(id, name, email)
VALUES (?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
  name = excluded.name,
  email = excluded.email;

deleteById:
DELETE FROM user
WHERE id = ?;

deleteAll:
DELETE FROM user;
